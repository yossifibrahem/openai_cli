# OpenAI API key — required
OPENAI_API_KEY=lm-studio

# ── Optional overrides ──────────────────────────────────────────────────────

# Use a local / compatible endpoint (Ollama, LM Studio, etc.)
AI_BASE_URL=http://localhost:1234/v1

# Default model
AI_MODEL=qwen/qwen3.5-2b

# Default temperature
# AI_TEMPERATURE=0.7

# Max tokens per response (omit for model default)
# AI_MAX_TOKENS=4096

# Default system prompt
# AI_SYSTEM_PROMPT=You are a helpful assistant.

# Request timeout in seconds
# AI_TIMEOUT=60

# Keep last N messages in context window
# AI_CONTEXT_WINDOW=20

# Code theme for syntax highlighting
# AI_THEME=monokai

# Show token usage after each response
# AI_SHOW_TOKEN_USAGE=true
